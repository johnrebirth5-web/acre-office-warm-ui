  office_manager
  office_user
  office_admin
  owner
  accountant
  human_resources
  team_lead
}

enum MembershipStatus {
  active
  invited
  disabled
}

enum ListingStatus {
  draft
  active
  hot
  pending
  off_market
  sold
}

enum TaskStatus {
  queued
  in_progress
  completed
  canceled
}

