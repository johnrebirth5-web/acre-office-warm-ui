model Organization {
  id                                String                             @id @default(cuid())
  name                              String
  slug                              String                             @unique
  timezone                          String                             @default("America/New_York")
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt
  offices                           Office[]
  memberships                       Membership[]
  invitations                       Invitation[]
  membershipNotificationPreferences MembershipNotificationPreference[]
  listings                          Listing[]
  clients                           Client[]
  followUpTasks                     FollowUpTask[]
  notifications                     Notification[]
  events                            Event[]
  resources                         Resource[]
  vendors                           Vendor[]
  libraryFolders                    LibraryFolder[]
  libraryDocuments                  LibraryDocument[]
  auditLogs                         AuditLog[]
  transactions                      Transaction[]
  transactionContacts               TransactionContact[]
  transactionTasks                  TransactionTask[]
  taskListViews                     TaskListView[]
  ledgerAccounts                    LedgerAccount[]
  accountingTransactions            AccountingTransaction[]
  accountingTransactionLineItems    AccountingTransactionLineItem[]
  accountingTransactionApplications AccountingTransactionApplication[]
  generalLedgerEntries              GeneralLedgerEntry[]
  earnestMoneyRecords               EarnestMoneyRecord[]
  agentRecurringChargeRules         AgentRecurringChargeRule[]
  agentPaymentMethods               AgentPaymentMethod[]
  agentBankInformationRecords       AgentBankInformation[]
  agent1099PaymentRecords           Agent1099PaymentRecord[]
  transactionDocuments              TransactionDocument[]
  formTemplates                     FormTemplate[]
  transactionForms                  TransactionForm[]
  signatureRequests                 SignatureRequest[]
  incomingUpdates                   IncomingUpdate[]
  offers                            Offer[]
  offerComments                     OfferComment[]
  transactionMembershipLinks        TransactionMembershipLink[]
  agentProfiles                     AgentProfile[]
  teams                             Team[]
  teamMemberships                   TeamMembership[]
  agentOnboardingTemplateItems      AgentOnboardingTemplateItem[]
  agentOnboardingItems              AgentOnboardingItem[]
  agentGoals                        AgentGoal[]
  commissionSplitTemplates          CommissionSplitTemplate[]
  membershipCommissionSettings      MembershipCommissionSetting[]
  commissionPlans                   CommissionPlan[]
  commissionPlanAssignments         CommissionPlanAssignment[]
  commissionPlanRules               CommissionPlanRule[]
  commissionCalculations            CommissionCalculation[]
  agentPayoutStatements             AgentPayoutStatement[]
  agentPayoutStatementManualLineItems AgentPayoutStatementManualLineItem[]
  transactionFinanceFees            TransactionFinanceFee[]
  transactionFinanceCalculationVersions TransactionFinanceCalculationVersion[]
  requiredContactRoleSettings       RequiredContactRoleSetting[]
  transactionFieldSettings          TransactionFieldSetting[]
  transactionCustomFieldDefinitions TransactionCustomFieldDefinition[]
  contactFieldSettings              ContactFieldSetting[]
  contactCustomFieldDefinitions     ContactCustomFieldDefinition[]
  offerFieldSettings                OfferFieldSetting[]
  offerCustomFieldDefinitions       OfferCustomFieldDefinition[]
  checklistTemplates                ChecklistTemplate[]
  checklistTemplateItems            ChecklistTemplateItem[]
  tableLayouts                      OrganizationTableLayout[]
  transactionSearchLayouts          TransactionSearchLayout[]
  transactionReportSearchLayouts    TransactionReportSearchLayout[]
  roleTemplates                     OrganizationRoleTemplate[]
  roleTemplatePermissions           OrganizationRoleTemplatePermission[]
  membershipPermissionOverrides     MembershipPermissionOverride[]
}

model Office {
  id                                String                             @id @default(cuid())
  organizationId                    String
  name                              String
  slug                              String
  market                            String
  isPrimary                         Boolean                            @default(false)
  createdAt                         DateTime                           @default(now())
  updatedAt                         DateTime                           @updatedAt
  organization                      Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships                       Membership[]
  membershipNotificationPreferences MembershipNotificationPreference[]
  notifications                     Notification[]
  listings                          Listing[]
  events                            Event[]
  resources                         Resource[]
  vendors                           Vendor[]
  libraryFolders                    LibraryFolder[]
  libraryDocuments                  LibraryDocument[]
  transactions                      Transaction[]
  taskListViews                     TaskListView[]
  ledgerAccounts                    LedgerAccount[]
  accountingTransactions            AccountingTransaction[]
  accountingTransactionLineItems    AccountingTransactionLineItem[]
  accountingTransactionApplications AccountingTransactionApplication[]
  generalLedgerEntries              GeneralLedgerEntry[]
  earnestMoneyRecords               EarnestMoneyRecord[]
  agentRecurringChargeRules         AgentRecurringChargeRule[]
  agentPaymentMethods               AgentPaymentMethod[]
  agentBankInformationRecords       AgentBankInformation[]
  agent1099PaymentRecords           Agent1099PaymentRecord[]
  transactionDocuments              TransactionDocument[]
  formTemplates                     FormTemplate[]
  transactionForms                  TransactionForm[]
  signatureRequests                 SignatureRequest[]
  incomingUpdates                   IncomingUpdate[]
  offers                            Offer[]
  offerComments                     OfferComment[]
  transactionMembershipLinks        TransactionMembershipLink[]
  agentProfiles                     AgentProfile[]
  teams                             Team[]
  teamMemberships                   TeamMembership[]
  agentOnboardingTemplateItems      AgentOnboardingTemplateItem[]
  agentOnboardingItems              AgentOnboardingItem[]
  agentGoals                        AgentGoal[]
  commissionSplitTemplates          CommissionSplitTemplate[]
  membershipCommissionSettings      MembershipCommissionSetting[]
  commissionPlans                   CommissionPlan[]
  commissionPlanAssignments         CommissionPlanAssignment[]
  commissionCalculations            CommissionCalculation[]
  agentPayoutStatements             AgentPayoutStatement[]
  agentPayoutStatementManualLineItems AgentPayoutStatementManualLineItem[]
  transactionFinanceFees            TransactionFinanceFee[]
  transactionFinanceCalculationVersions TransactionFinanceCalculationVersion[]
  requiredContactRoleSettings       RequiredContactRoleSetting[]
  transactionFieldSettings          TransactionFieldSetting[]
  transactionCustomFieldDefinitions TransactionCustomFieldDefinition[]
  contactFieldSettings              ContactFieldSetting[]
  contactCustomFieldDefinitions     ContactCustomFieldDefinition[]
  offerFieldSettings                OfferFieldSetting[]
  offerCustomFieldDefinitions       OfferCustomFieldDefinition[]
  checklistTemplates                ChecklistTemplate[]
  checklistTemplateItems            ChecklistTemplateItem[]
  transactionSearchLayouts          TransactionSearchLayout[]
  transactionReportSearchLayouts    TransactionReportSearchLayout[]

  @@unique([organizationId, slug])
}

model User {
  id          String         @id @default(cuid())
  email       String         @unique
  firstName   String
  lastName    String
  phone       String?
  timezone    String         @default("America/New_York")
  locale      String         @default("en-US")
  isActive    Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  memberships Membership[]
  credential  UserCredential?
}

model Membership {
  id                                       String                             @id @default(cuid())
  organizationId                           String
  officeId                                 String?
  userId                                   String
  role                                     UserRole
  status                                   MembershipStatus                   @default(active)
  title                                    String?
  permissions                              Json?
  createdAt                                DateTime                           @default(now())
  updatedAt                                DateTime                           @updatedAt
  organization                             Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office                                   Office?                            @relation(fields: [officeId], references: [id], onDelete: SetNull)
  user                                     User                               @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitations                              Invitation[]                       @relation("InvitationMembership")
  sentInvitations                          Invitation[]                       @relation("InvitationInvitedByMembership")
  notificationPreference                   MembershipNotificationPreference?
  listingsOwned                            Listing[]
  clientsOwned                             Client[]
  tasksAssigned                            FollowUpTask[]
  notifications                            Notification[]
  eventsCreated                            Event[]
  eventRsvps                               EventRsvp[]
  auditLogs                                AuditLog[]
  transactionsOwned                        Transaction[]
  transactionMembershipLinks               TransactionMembershipLink[]
  transactionTasksAssigned                 TransactionTask[]                  @relation("TransactionTaskAssignee")
  transactionTasksCompleted                TransactionTask[]                  @relation("TransactionTaskCompletedBy")
  transactionTasksSubmittedForReview       TransactionTask[]                  @relation("TransactionTaskSubmittedForReviewBy")
  transactionTasksFirstApproved            TransactionTask[]                  @relation("TransactionTaskFirstApprovedBy")
  transactionTasksSecondApproved           TransactionTask[]                  @relation("TransactionTaskSecondApprovedBy")
  transactionTasksRejected                 TransactionTask[]                  @relation("TransactionTaskRejectedBy")
  taskListViews                            TaskListView[]
  accountingTransactionsCreated            AccountingTransaction[]            @relation("AccountingTransactionCreatedBy")
  accountingTransactionsRelated            AccountingTransaction[]            @relation("AccountingTransactionRelatedMembership")
  accountingTransactionApplicationsCreated AccountingTransactionApplication[] @relation("AccountingTransactionApplicationCreatedBy")
  earnestMoneyRecordsCreated               EarnestMoneyRecord[]               @relation("EarnestMoneyCreatedBy")
  agentRecurringChargeRules                AgentRecurringChargeRule[]         @relation("AgentRecurringChargeRuleMembership")
  agentPaymentMethods                      AgentPaymentMethod[]
  agentBankInformation                     AgentBankInformation?
  agent1099PaymentRecords                  Agent1099PaymentRecord[]           @relation("Agent1099PaymentRecordMembership")
  createdLibraryFolders                    LibraryFolder[]                    @relation("LibraryFolderCreatedBy")
  uploadedTransactionDocuments             TransactionDocument[]              @relation("TransactionDocumentUploadedBy")
  uploadedLibraryDocuments                 LibraryDocument[]                  @relation("LibraryDocumentUploadedBy")
  createdTransactionForms                  TransactionForm[]                  @relation("TransactionFormCreatedBy")
  requestedSignatureRequests               SignatureRequest[]                 @relation("SignatureRequestRequestedBy")
  signatureAuditEntries                    SignatureAuditEntry[]
  reviewedIncomingUpdates                  IncomingUpdate[]                   @relation("IncomingUpdateReviewedBy")
  createdOffers                            Offer[]                            @relation("OfferCreatedBy")
  offerComments                            OfferComment[]
  agentProfile                             AgentProfile?
  teamMemberships                          TeamMembership[]
  agentOnboardingItems                     AgentOnboardingItem[]
  completedAgentOnboardingItems            AgentOnboardingItem[]              @relation("AgentOnboardingCompletedBy")
  agentGoals                               AgentGoal[]
  membershipCommissionSettings             MembershipCommissionSetting[]
  commissionPlanAssignments                CommissionPlanAssignment[]
  commissionCalculations                   CommissionCalculation[]            @relation("CommissionCalculationMembership")
  calculatedCommissionCalculations         CommissionCalculation[]            @relation("CommissionCalculationCalculatedBy")
  agentPayoutStatements                    AgentPayoutStatement[]
  generatedAgentPayoutStatements           AgentPayoutStatement[]             @relation("AgentPayoutStatementGeneratedBy")
  agentPayoutStatementManualLineItems        AgentPayoutStatementManualLineItem[] @relation("AgentPayoutStatementManualLineItemMembership")
  createdAgentPayoutStatementManualLineItems AgentPayoutStatementManualLineItem[] @relation("AgentPayoutStatementManualLineItemCreatedBy")
  createdAgent1099PaymentRecords           Agent1099PaymentRecord[]           @relation("Agent1099PaymentRecordCreatedBy")
  approvedTransactionFinanceFees           TransactionFinanceFee[]            @relation("TransactionFinanceFeeApprovedBy")
  createdTransactionFinanceCalculationVersions TransactionFinanceCalculationVersion[] @relation("TransactionFinanceCalculationVersionCreatedBy")
  checklistTemplatesCreated                ChecklistTemplate[]                @relation("ChecklistTemplateCreatedBy")
  checklistTemplatesUpdated                ChecklistTemplate[]                @relation("ChecklistTemplateUpdatedBy")
  updatedTableLayouts                      OrganizationTableLayout[]          @relation("OrganizationTableLayoutUpdatedBy")
  updatedTransactionSearchLayouts          TransactionSearchLayout[]          @relation("TransactionSearchLayoutUpdatedBy")
  updatedTransactionReportSearchLayouts    TransactionReportSearchLayout[]    @relation("TransactionReportSearchLayoutUpdatedBy")
  updatedRoleTemplates                     OrganizationRoleTemplate[]         @relation("OrganizationRoleTemplateUpdatedBy")
  permissionOverrides                      MembershipPermissionOverride[]     @relation("MembershipPermissionOverrideMembership")
  createdPermissionOverrides               MembershipPermissionOverride[]     @relation("MembershipPermissionOverrideCreatedBy")
  ownedLibraryFolders                      LibraryFolder[]                    @relation("LibraryFolderOwner")
  ownedLibraryDocuments                    LibraryDocument[]                  @relation("LibraryDocumentOwner")

  @@unique([organizationId, userId])
}

model OrganizationRoleTemplate {
  id                    String                           @id @default(cuid())
  organizationId        String
  role                  UserRole
  label                 String
  description           String?
  updatedByMembershipId String?
  createdAt             DateTime                         @default(now())
  updatedAt             DateTime                         @updatedAt
  organization          Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByMembership   Membership?                      @relation("OrganizationRoleTemplateUpdatedBy", fields: [updatedByMembershipId], references: [id], onDelete: SetNull)
  permissions           OrganizationRoleTemplatePermission[]

  @@unique([organizationId, role])
  @@index([organizationId, updatedAt])
}

model OrganizationRoleTemplatePermission {
  id                         String                   @id @default(cuid())
  organizationId             String
  organizationRoleTemplateId String
  permissionKey              String
  createdAt                  DateTime                 @default(now())
  updatedAt                  DateTime                 @updatedAt
  organization               Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  organizationRoleTemplate   OrganizationRoleTemplate @relation(fields: [organizationRoleTemplateId], references: [id], onDelete: Cascade)

  @@unique([organizationRoleTemplateId, permissionKey])
  @@index([organizationId, permissionKey])
}

model MembershipPermissionOverride {
  id                    String                   @id @default(cuid())
  organizationId        String
  membershipId          String
  permissionKey         String
  effect                PermissionOverrideEffect
  createdByMembershipId String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  organization          Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership            Membership               @relation("MembershipPermissionOverrideMembership", fields: [membershipId], references: [id], onDelete: Cascade)
  createdByMembership   Membership?              @relation("MembershipPermissionOverrideCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@unique([membershipId, permissionKey])
  @@index([organizationId, permissionKey])
}

model OrganizationTableLayout {
  id                    String       @id @default(cuid())
  organizationId        String
  updatedByMembershipId String?
  tableKey              String
  columnLayout          Json
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  updatedByMembership   Membership?  @relation("OrganizationTableLayoutUpdatedBy", fields: [updatedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([organizationId, tableKey])
  @@index([organizationId])
}

model TransactionSearchLayout {
  id                    String       @id @default(cuid())
  organizationId        String
  officeId              String?
  updatedByMembershipId String?
  fieldLayout           Json
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office                Office?      @relation(fields: [officeId], references: [id], onDelete: SetNull)
  updatedByMembership   Membership?  @relation("TransactionSearchLayoutUpdatedBy", fields: [updatedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([organizationId, officeId])
  @@index([organizationId, officeId])
}

model TransactionReportSearchLayout {
  id                    String       @id @default(cuid())
  organizationId        String
  officeId              String?
  updatedByMembershipId String?
  fieldLayout           Json
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office                Office?      @relation(fields: [officeId], references: [id], onDelete: SetNull)
  updatedByMembership   Membership?  @relation("TransactionReportSearchLayoutUpdatedBy", fields: [updatedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([organizationId, officeId])
  @@index([organizationId, officeId])
}

model UserCredential {
  id                String   @id @default(cuid())
  userId            String   @unique
  passwordHash      String
  mustChangePassword Boolean @default(false)
  failedLoginCount  Int      @default(0)
  lockedUntil       DateTime?
  lastLoginAt       DateTime?
  lastFailedLoginAt DateTime?
  passwordChangedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invitation {
  id                   String      @id @default(cuid())
  organizationId       String
  membershipId         String
  email                String
  tokenHash            String      @unique
  expiresAt            DateTime
  acceptedAt           DateTime?
  revokedAt            DateTime?
  invitedByMembershipId String?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  membership           Membership   @relation("InvitationMembership", fields: [membershipId], references: [id], onDelete: Cascade)
  invitedByMembership  Membership?  @relation("InvitationInvitedByMembership", fields: [invitedByMembershipId], references: [id], onDelete: SetNull)

  @@index([organizationId, membershipId])
  @@index([organizationId, email])
  @@index([organizationId, expiresAt])
}

model MembershipNotificationPreference {
  id                    String       @id @default(cuid())
  organizationId        String
  officeId              String?
  membershipId          String       @unique
  inAppEnabled          Boolean      @default(true)
  approvalAlertsEnabled Boolean      @default(true)
  taskRemindersEnabled  Boolean      @default(true)
  offerAlertsEnabled    Boolean      @default(true)
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office                Office?      @relation(fields: [officeId], references: [id], onDelete: SetNull)
  membership            Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([organizationId, officeId])
  @@index([organizationId, membershipId])
}

model Transaction {
  id                             String                          @id @default(cuid())
  organizationId                 String
  officeId                       String?
  ownerMembershipId              String?
  primaryClientId                String?
  type                           TransactionType
  status                         TransactionStatus               @default(opportunity)
  representing                   TransactionRepresenting
  title                          String
  address                        String
  city                           String
  state                          String
  zipCode                        String
  askingPrice                    Decimal?                        @db.Decimal(12, 2)
  purchasedPrice                 Decimal?                        @db.Decimal(12, 2)
  price                          Decimal?                        @db.Decimal(12, 2)
  importantDate                  DateTime?
  buyerAgreementDate             DateTime?
  buyerExpirationDate            DateTime?
  acceptanceDate                 DateTime?
  listingDate                    DateTime?
  listingExpirationDate          DateTime?
  closingDate                    DateTime?
  moveInDate                     DateTime?
  companyReferral                Boolean                         @default(false)
  companyReferralEmployeeName    String?
  clientReferralFormApproved     Boolean                         @default(false)
  rebateAgreementSigned          Boolean                         @default(false)
  rebateGoogleFormSubmitted      Boolean                         @default(false)
  referralContext                Json?
  grossCommission                Decimal?                        @db.Decimal(12, 2)
  referralFee                    Decimal?                        @db.Decimal(12, 2)
  officeNet                      Decimal?                        @db.Decimal(12, 2)
  agentNet                       Decimal?                        @db.Decimal(12, 2)
  financeNotes                   String?
  commissionContext              Json?
  additionalFields               Json?
  createdAt                      DateTime                        @default(now())
  updatedAt                      DateTime                        @updatedAt
  organization                   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office                         Office?                         @relation(fields: [officeId], references: [id], onDelete: SetNull)
  ownerMembership                Membership?                     @relation(fields: [ownerMembershipId], references: [id], onDelete: SetNull)
  primaryClient                  Client?                         @relation("TransactionPrimaryClient", fields: [primaryClientId], references: [id], onDelete: SetNull)
  transactionContacts            TransactionContact[]
  tasks                          TransactionTask[]
  accountingTransactions         AccountingTransaction[]
  accountingTransactionLineItems AccountingTransactionLineItem[]
  generalLedgerEntries           GeneralLedgerEntry[]
  earnestMoneyRecords            EarnestMoneyRecord[]
  documents                      TransactionDocument[]
  forms                          TransactionForm[]
  signatureRequests              SignatureRequest[]
  incomingUpdates                IncomingUpdate[]
  offers                         Offer[]
  commissionCalculations         CommissionCalculation[]
  financeFees                    TransactionFinanceFee[]
  financeCalculationVersions     TransactionFinanceCalculationVersion[]
  membershipLinks                TransactionMembershipLink[]

  @@index([organizationId, status])
  @@index([organizationId, officeId])
  @@index([organizationId, ownerMembershipId])
  @@index([organizationId, primaryClientId])
}

model Listing {
  id                String             @id @default(cuid())
  organizationId    String
  officeId          String?
