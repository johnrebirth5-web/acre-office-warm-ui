  @@index([organizationId, transactionId])
  @@index([organizationId, transactionFinanceCalculationVersionId])
  @@index([organizationId, membershipId])
  @@index([organizationId, commissionPlanId])
  @@index([organizationId, calculatedAt])
}

model AgentPayoutStatement {
  id                       String                               @id @default(cuid())
  organizationId           String
  officeId                 String?
  membershipId             String
  periodStart              DateTime
  periodEnd                DateTime
  periodBasis              AgentPayoutStatementPeriodBasis
  reviewStatus             AgentPayoutStatementReviewStatus     @default(draft)
  generatedAt              DateTime                             @default(now())
  generatedByMembershipId  String?
  lastSharedAt             DateTime?
  lastSharedByMembershipId String?
  agentRespondedAt         DateTime?
  confirmedAt              DateTime?
  lineItemCount            Int                                  @default(0)
  totalStatementAmount     Decimal                              @default(0) @db.Decimal(12, 2)
  totalGrossCommission     Decimal                              @default(0) @db.Decimal(12, 2)
  totalOfficeNet           Decimal                              @default(0) @db.Decimal(12, 2)
  totalAgentNet            Decimal                              @default(0) @db.Decimal(12, 2)
  quickBooksBillStatus                  AgentPayoutStatementQuickBooksBillStatus @default(not_posted)
  quickBooksBillId                      String?
  quickBooksBillDocNumber               String?
  quickBooksBillPostedAt                DateTime?
  quickBooksBillRequestId               String?
  quickBooksBillSyncError               String?
  quickBooksBillAccountingTransactionId String?
  organization             Organization                         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office                   Office?                              @relation(fields: [officeId], references: [id], onDelete: SetNull)
  membership               Membership                           @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  generatedByMembership    Membership?                          @relation("AgentPayoutStatementGeneratedBy", fields: [generatedByMembershipId], references: [id], onDelete: SetNull)
  lastSharedByMembership   Membership?                          @relation("AgentPayoutStatementLastSharedBy", fields: [lastSharedByMembershipId], references: [id], onDelete: SetNull)
  lineItems                AgentPayoutStatementLine[]
  messages                 AgentPayoutStatementMessage[]
  manualLineItems          AgentPayoutStatementManualLineItem[]

  @@index([organizationId, officeId, generatedAt])
  @@index([organizationId, membershipId, generatedAt])
  @@index([organizationId, reviewStatus, generatedAt])
  @@index([organizationId, quickBooksBillStatus, generatedAt], map: "AgentPayoutStatement_org_qbBillStatus_generatedAt_idx")
  @@index([organizationId, periodStart, periodEnd])
}

model AgentPayoutStatementLine {
  id                      String                      @id @default(cuid())
  statementId             String
  commissionCalculationId String
  transactionId           String
  transactionLabel        String
  propertyAddress         String
  transactionCreatedAt    DateTime?
  invoiceNumber           String                      @default("")
  ownerName               String                      @default("")
  buildingName            String                      @default("")
  unitNumber              String                      @default("")
  commissionRate          String                      @default("")
  closingDate             DateTime?
  calculatedAt            DateTime
  statusAtGeneration      CommissionCalculationStatus
  grossCommission         Decimal                     @default(0) @db.Decimal(12, 2)
  referralFee             Decimal                     @default(0) @db.Decimal(12, 2)
  fees                    Decimal                     @default(0) @db.Decimal(12, 2)
  officeNet               Decimal                     @default(0) @db.Decimal(12, 2)
  agentNet                Decimal                     @default(0) @db.Decimal(12, 2)
  statementAmount         Decimal                     @default(0) @db.Decimal(12, 2)
  feeBreakdown            Json?
  statement               AgentPayoutStatement        @relation(fields: [statementId], references: [id], onDelete: Cascade)

  @@index([statementId])
  @@index([commissionCalculationId])
  @@index([transactionId])
}

model AgentPayoutStatementManualLineItem {
  id                    String               @id @default(cuid())
  statementId           String
  organizationId        String
  officeId              String?
  membershipId          String
  memo                  String
  amount                Decimal              @default(0) @db.Decimal(12, 2)
  createdByMembershipId String
  createdAt             DateTime             @default(now())
  statement             AgentPayoutStatement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office                Office?              @relation(fields: [officeId], references: [id], onDelete: SetNull)
  membership            Membership           @relation("AgentPayoutStatementManualLineItemMembership", fields: [membershipId], references: [id], onDelete: Cascade)
  createdByMembership   Membership           @relation("AgentPayoutStatementManualLineItemCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: Restrict)

  @@index([statementId, createdAt])
  @@index([organizationId, officeId, createdAt])
  @@index([membershipId, createdAt])
  @@index([createdByMembershipId, createdAt])
}

model AgentPayoutStatementMessage {
  id             String                          @id @default(cuid())
  statementId    String
  organizationId String
  officeId       String?
  membershipId   String
  messageType    AgentPayoutStatementMessageType
  body           String                          @default("")
  createdAt      DateTime                        @default(now())
  statement      AgentPayoutStatement            @relation(fields: [statementId], references: [id], onDelete: Cascade)
  organization   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office         Office?                         @relation(fields: [officeId], references: [id], onDelete: SetNull)
  membership     Membership                      @relation("AgentPayoutStatementMessageMembership", fields: [membershipId], references: [id], onDelete: Cascade)

  @@index([statementId, createdAt])
  @@index([organizationId, officeId, createdAt])
  @@index([membershipId, createdAt])
}

model TransactionFinanceFee {
  id                      String                            @id @default(cuid())
  organizationId          String
  officeId                String?
  transactionId           String
  feeType                 TransactionFinanceFeeType
  defaultRate             Decimal?                          @db.Decimal(5, 2)
  rate                    Decimal?                          @db.Decimal(5, 2)
  amount                  Decimal?                          @db.Decimal(12, 2)
  defaultCalculationType  TransactionFinanceCalculationType
  selectedCalculationType TransactionFinanceCalculationType
  approvalRequired        Boolean                           @default(false)
  approvalStatus          TransactionFinanceApprovalStatus  @default(not_required)
  notes                   String?
  approvedAt              DateTime?
  approvedByMembershipId  String?
  createdAt               DateTime                          @default(now())
  updatedAt               DateTime                          @updatedAt
  organization            Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office                  Office?                           @relation(fields: [officeId], references: [id], onDelete: SetNull)
  transaction             Transaction                       @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  approvedByMembership    Membership?                       @relation("TransactionFinanceFeeApprovedBy", fields: [approvedByMembershipId], references: [id], onDelete: SetNull)

  @@unique([transactionId, feeType])
  @@index([organizationId, officeId, feeType])
  @@index([organizationId, transactionId])
}

model TransactionFinanceCalculationVersion {
  id                     String                          @id @default(cuid())
  organizationId         String
  officeId               String?
  transactionId          String
  versionNumber          Int
  sourceType             TransactionFinanceVersionSource
  isCurrent              Boolean                         @default(false)
  grossCommission        Decimal                         @default(0) @db.Decimal(12, 2)
  preSplitTotal          Decimal                         @default(0) @db.Decimal(12, 2)
  postSplitTotal         Decimal                         @default(0) @db.Decimal(12, 2)
  netCommissionBase      Decimal                         @default(0) @db.Decimal(12, 2)
  reimbursementAmount    Decimal                         @default(0) @db.Decimal(12, 2)
  finalAgentNet          Decimal                         @default(0) @db.Decimal(12, 2)
  finalOfficeNet         Decimal                         @default(0) @db.Decimal(12, 2)
  feeBreakdown           Json?
  stakeholderBreakdown   Json?
  blockingIssues         Json?
  notes                  String?
  overrideReason         String?
  createdByMembershipId  String?
  createdAt              DateTime                        @default(now())
  updatedAt              DateTime                        @updatedAt
  organization           Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office                 Office?                         @relation(fields: [officeId], references: [id], onDelete: SetNull)
  transaction            Transaction                     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdByMembership    Membership?                     @relation("TransactionFinanceCalculationVersionCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)
  commissionCalculations CommissionCalculation[]

  @@unique([transactionId, versionNumber])
  @@index([organizationId, officeId, isCurrent])
  @@index([organizationId, transactionId, isCurrent])
}

model EarnestMoneyRecord {
  id                    String             @id @default(cuid())
  organizationId        String
  officeId              String?
  transactionId         String
  expectedAmount        Decimal            @db.Decimal(12, 2)
  dueAt                 DateTime
  receivedAmount        Decimal            @default(0) @db.Decimal(12, 2)
  refundedAmount        Decimal            @default(0) @db.Decimal(12, 2)
  paymentDate           DateTime?
  depositDate           DateTime?
  heldByOffice          Boolean            @default(true)
  heldExternally        Boolean            @default(false)
  trackInLedger         Boolean            @default(true)
  status                EarnestMoneyStatus @default(not_received)
  notes                 String?
  createdByMembershipId String?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office                Office?            @relation(fields: [officeId], references: [id], onDelete: SetNull)
  transaction           Transaction        @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  createdByMembership   Membership?        @relation("EarnestMoneyCreatedBy", fields: [createdByMembershipId], references: [id], onDelete: SetNull)

  @@unique([transactionId])
  @@index([organizationId, officeId, status])
  @@index([organizationId, dueAt])
}
