model User {
  id          String          @id @default(cuid())
  email       String          @unique
  firstName   String
  lastName    String
  phone       String?
  timezone    String          @default("America/New_York")
  locale      String          @default("en-US")
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  memberships Membership[]
  credential  UserCredential?
}

model Membership {
  id                                           String                                 @id @default(cuid())
  organizationId                               String
  officeId                                     String?
  userId                                       String
  role                                         UserRole
  status                                       MembershipStatus                       @default(active)
  title                                        String?
  permissions                                  Json?
  createdAt                                    DateTime                               @default(now())
  updatedAt                                    DateTime                               @updatedAt
  organization                                 Organization                           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  office                                       Office?                                @relation(fields: [officeId], references: [id], onDelete: SetNull)
  user                                         User                                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  invitations                                  Invitation[]                           @relation("InvitationMembership")
  sentInvitations                              Invitation[]                           @relation("InvitationInvitedByMembership")
  notificationPreference                       MembershipNotificationPreference?
  listingsOwned                                Listing[]
  frontOfficeSendRecordsSent                   FrontOfficeSendRecord[]
  frontOfficeAiAcceptedActions                 FrontOfficeAiAcceptedAction[]
  clientsOwned                                 Client[]
  appointmentsOwned                            Appointment[]
  clientStageHistoryEntries                    ClientStageHistory[]
  frontOfficeHandoffDrafts                     FrontOfficeHandoffDraft[]
  frontOfficeCleanupRuns                       FrontOfficeCleanupRun[]
  tasksAssigned                                FollowUpTask[]
  notifications                                Notification[]
  eventsCreated                                Event[]
  eventRsvps                                   EventRsvp[]
  auditLogs                                    AuditLog[]
  transactionsOwned                            Transaction[]
  transactionMembershipLinks                   TransactionMembershipLink[]
  transactionTasksAssigned                     TransactionTask[]                      @relation("TransactionTaskAssignee")
  transactionTasksCompleted                    TransactionTask[]                      @relation("TransactionTaskCompletedBy")
  transactionTasksSubmittedForReview           TransactionTask[]                      @relation("TransactionTaskSubmittedForReviewBy")
  transactionTasksFirstApproved                TransactionTask[]                      @relation("TransactionTaskFirstApprovedBy")
  transactionTasksSecondApproved               TransactionTask[]                      @relation("TransactionTaskSecondApprovedBy")
  transactionTasksRejected                     TransactionTask[]                      @relation("TransactionTaskRejectedBy")
  taskListViews                                TaskListView[]
  accountingTransactionsCreated                AccountingTransaction[]                @relation("AccountingTransactionCreatedBy")
  accountingTransactionsRelated                AccountingTransaction[]                @relation("AccountingTransactionRelatedMembership")
  accountingTransactionApplicationsCreated     AccountingTransactionApplication[]     @relation("AccountingTransactionApplicationCreatedBy")
  earnestMoneyRecordsCreated                   EarnestMoneyRecord[]                   @relation("EarnestMoneyCreatedBy")
  agentRecurringChargeRules                    AgentRecurringChargeRule[]             @relation("AgentRecurringChargeRuleMembership")
  agentPaymentMethods                          AgentPaymentMethod[]
  agentBankInformation                         AgentBankInformation?
  agent1099PaymentRecords                      Agent1099PaymentRecord[]               @relation("Agent1099PaymentRecordMembership")
