{
  "name": "acre",
  "private": true,
  "packageManager": "npm@10.9.4",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev-web.mjs",
    "docker:dev:up": "docker compose up -d",
    "docker:dev:down": "docker compose down",
    "docker:dev:logs": "docker compose logs -f web",
    "docker:dev:ps": "docker compose ps",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "provision:backoffice-accounts": "tsx scripts/provision-backoffice-initial-accounts.ts",
    "deploy:digitalocean": "bash ./scripts/deploy-digitalocean.sh",
    "test:backoffice-hardening": "tsx --test packages/auth/src/index.test.ts packages/db/src/auth.test.ts packages/db/src/settings.test.ts apps/web/lib/auth-session.test.ts apps/web/lib/request-origin.test.ts apps/web/lib/document-storage.test.ts",
    "db:generate": "npm run db:generate --workspace=@acre/db",
    "db:migrate": "npm run db:migrate --workspace=@acre/db --",
    "db:seed": "npm run db:seed --workspace=@acre/db",
    "db:validate": "npm run db:validate --workspace=@acre/db",
    "db:sync:from-production": "bash ./scripts/sync-production-db-to-local.sh"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "tsx": "^4.21.0",
    "turbo": "^2.8.14",
    "typescript": "^5.9.3"
  }
}
