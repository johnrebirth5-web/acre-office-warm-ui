# Host-mode local default. docker-compose keeps the container on db:5432, but publishes
# PostgreSQL to the host on 127.0.0.1:5433 to avoid collisions with a local Homebrew/Postgres.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/acre"
# Optional DO tunnel mode for local development. Host tools use 127.0.0.1:15432, while
# the Docker web container should use host.lima.internal:15432.
# DATABASE_URL="postgresql://acre_app:<do-db-password>@127.0.0.1:15432/acre"
# ACRE_DOCKER_DATABASE_URL="postgresql://acre_app:<do-db-password>@host.lima.internal:15432/acre"
# ACRE_DO_DB_TUNNEL_BIND_HOST="0.0.0.0"
# ACRE_DO_DB_TUNNEL_CONTAINER_HOST="host.lima.internal"
# Generate a strong value with: `tsx scripts/generate-session-secret.ts`
# Do not keep long-lived production or shared-environment secrets in the repo worktree.
ACRE_SESSION_SECRET="<generated-session-secret>"
# Optional during rotation. Keep the previous value here only until old cookies age out,
# then remove it from the environment source entirely.
# ACRE_SESSION_SECRET_SECONDARY="<previous-generated-session-secret>"
ACRE_BASE_URL="http://localhost:3105"
ACRE_RATE_LIMIT_BACKEND="memory"
# Required only when ACRE_RATE_LIMIT_BACKEND="upstash"
# ACRE_UPSTASH_REDIS_REST_URL="https://example.upstash.io"
# ACRE_UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-rest-token"
# Controls which upstream proxy header gets first priority for rate-limit client IDs.
# Supported values: none, cloudflare, reverse-proxy
ACRE_TRUSTED_PROXY_TIER="none"
ACRE_DOCUMENTS_STORAGE_DIR="/absolute/path/to/local-document-storage"
# Local-only override. Production should leave this unset or explicitly set it to "true".
ACRE_SECURE_COOKIES="false"
# Recommended in shared or production environments so SMTP / Signature Drive encryption
# does not depend on the session cookie secret.
ACRE_SETTINGS_ENCRYPTION_SECRET="<generated-settings-secret>"
ACRE_RESEND_API_KEY=""
ACRE_SMTP_HOST="smtp.example.com"
ACRE_SMTP_PORT="587"
ACRE_SMTP_SECURE="false"
ACRE_SMTP_USER="smtp-user"
ACRE_SMTP_PASSWORD="replace-with-smtp-password"
ACRE_SIGNATURE_FROM_EMAIL="signatures@example.com"
ACRE_SIGNATURE_FROM_NAME="Acre Signatures"
ACRE_SIGNATURE_REPLY_TO="agent@example.com"
