# Host-mode local default. docker-compose keeps the container on db:5432, but publishes
# PostgreSQL to the host on 127.0.0.1:5433 to avoid collisions with a local Homebrew/Postgres.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/acre"
# Optional Prisma pool tuning. Leave unset locally unless you need to reproduce
# production-like pooling behavior or are testing a specific limit.
# PRISMA_CONNECTION_LIMIT="15"
# PRISMA_POOL_TIMEOUT="10"
# Optional DO tunnel mode for local development. Host tools use 127.0.0.1:15432, while
# the Docker web container should use host.docker.internal:15432 (OrbStack / Docker Desktop).
# DATABASE_URL="postgresql://acre_app:<do-db-password>@127.0.0.1:15432/acre"
# ACRE_DOCKER_DATABASE_URL="postgresql://acre_app:<do-db-password>@host.docker.internal:15432/acre"
# ACRE_DO_DB_TUNNEL_BIND_HOST="0.0.0.0"
# ACRE_DO_DB_TUNNEL_CONTAINER_HOST="host.docker.internal"
# Generate a strong value with: `tsx scripts/generate-session-secret.ts`
# Do not keep long-lived production or shared-environment secrets in the repo worktree.
ACRE_SESSION_SECRET="<generated-session-secret>"
# Optional during rotation. Keep the previous value here only until old cookies age out,
# then remove it from the environment source entirely.
# ACRE_SESSION_SECRET_SECONDARY="<previous-generated-session-secret>"
ACRE_BASE_URL="http://localhost:3105"
# Optional Admin Assistant Codex gateway settings. Use a dedicated OpenClaw/Codex
# OAuth login on the server; do not copy a local desktop Codex session token.
# ACRE_ADMIN_CODEX_GATEWAY_URL="ws://127.0.0.1:18789"
# ACRE_ADMIN_CODEX_GATEWAY_TOKEN=""
# ACRE_ADMIN_CODEX_GATEWAY_PASSWORD=""
# ACRE_ADMIN_CODEX_AGENT_ID="acre-admin-help"
# ACRE_ADMIN_CODEX_THINKING="low"
# ACRE_ADMIN_CODEX_TIMEOUT_SECONDS="90"
# ACRE_ADMIN_CODEX_MAX_IMAGES="3"
# ACRE_ADMIN_CODEX_MAX_IMAGE_BYTES="1048576"
# ACRE_ADMIN_CODEX_MAX_TOTAL_IMAGE_BYTES="2097152"
ACRE_METRICS_TOKEN=""
ACRE_RATE_LIMIT_BACKEND="memory"
# When a non-memory rate limit backend (redis/upstash) fails, whether to
# fall back to the in-process memory counter ("open", default) or propagate
# the error to callers ("closed"). Open prioritizes availability of auth
# endpoints; closed prioritizes strict enforcement. Operators can flip this
# without a code change.
ACRE_RATE_LIMIT_FAIL_MODE=open
# Required only when ACRE_RATE_LIMIT_BACKEND="upstash"
# ACRE_UPSTASH_REDIS_REST_URL="https://example.upstash.io"
# ACRE_UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-rest-token"
# Controls which upstream proxy header gets first priority for rate-limit client IDs.
# Supported values: none, cloudflare, reverse-proxy
ACRE_TRUSTED_PROXY_TIER="none"
ACRE_DOCUMENTS_STORAGE_DIR="/absolute/path/to/local-document-storage"
# Local-only override. Production should leave this unset or explicitly set it to "true".
ACRE_SECURE_COOKIES="false"
# Recommended in shared or production environments so SMTP / Signature Drive encryption
# does not depend on the session cookie secret.
ACRE_SETTINGS_ENCRYPTION_SECRET="<generated-settings-secret>"
ACRE_RESEND_API_KEY=""
ACRE_SMTP_HOST="smtp.example.com"
ACRE_SMTP_PORT="587"
ACRE_SMTP_SECURE="false"
ACRE_SMTP_USER="smtp-user"
ACRE_SMTP_PASSWORD="replace-with-smtp-password"
ACRE_SIGNATURE_FROM_EMAIL="signatures@example.com"
ACRE_SIGNATURE_FROM_NAME="Acre Signatures"
ACRE_SIGNATURE_REPLY_TO="agent@example.com"
# QuickBooks OAuth accepts either QUICKBOOKS_* or ACRE_QUICKBOOKS_* names.
# The ACRE_* names are also used by payout-statement unpaid bill posting.
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_REDIRECT_URI="http://localhost:3105/api/office/settings/quickbooks/callback"
QUICKBOOKS_ENVIRONMENT="sandbox"
ACRE_QUICKBOOKS_CLIENT_ID=""
ACRE_QUICKBOOKS_CLIENT_SECRET=""
ACRE_QUICKBOOKS_REDIRECT_URI="http://localhost:3105/api/office/settings/quickbooks/callback"
# Production should map all three live QuickBooks companies. Keep refresh tokens out of Git.
# ACRE_QUICKBOOKS_OFFICE_CONNECTIONS_JSON='{"acre-nj-llc":{"companyName":"ACRE NJ LLC","realmId":"","refreshToken":"","apAccountId":"","agentCommissionExpenseAccountId":""},"acre-ny-realty":{"companyName":"ACRE NY REALTY INC","realmId":"","refreshToken":"","apAccountId":"","agentCommissionExpenseAccountId":""},"acre-ny-rental":{"companyName":"Acre NY Rentals LLC","realmId":"","refreshToken":"","apAccountId":"","agentCommissionExpenseAccountId":""}}'
ACRE_QUICKBOOKS_API_BASE_URL="https://quickbooks.api.intuit.com"
ACRE_QUICKBOOKS_MINOR_VERSION="75"
PRISMA_SLOW_QUERY_MS="500"
PRISMA_VERY_SLOW_QUERY_MS="2000"
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_AUTH_TOKEN=""
