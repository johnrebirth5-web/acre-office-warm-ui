# Host-mode local default. docker-compose keeps the container on db:5432, but publishes
# PostgreSQL to the host on 127.0.0.1:5433 to avoid collisions with a local Homebrew/Postgres.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/acre"
ACRE_SESSION_SECRET="replace-with-a-local-session-secret"
ACRE_DOCUMENTS_STORAGE_DIR="/absolute/path/to/local-document-storage"
ACRE_SECURE_COOKIES="false"
