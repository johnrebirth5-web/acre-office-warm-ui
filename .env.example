# Acre local development environment
#
# Copy this file to .env.local and replace placeholder values with local-only
# development values. Do not commit real secrets, production database URLs, API
# keys, private server paths, private domains, or deployment credentials.

# Local PostgreSQL published by docker-compose.yml.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/acre"

# Optional Prisma pool tuning.
# PRISMA_CONNECTION_LIMIT="15"
# PRISMA_POOL_TIMEOUT="10"

# Generate strong random values for shared or long-running environments.
# Example: openssl rand -hex 32
ACRE_SESSION_SECRET="replace-with-local-random-session-secret"
# ACRE_SESSION_SECRET_SECONDARY="replace-with-previous-session-secret-during-rotation"
ACRE_SETTINGS_ENCRYPTION_SECRET="replace-with-local-random-settings-secret"

# Local app URL used for generated links.
ACRE_BASE_URL="http://localhost:3105"
ACRE_SECURE_COOKIES="false"

# Local document storage.
ACRE_DOCUMENTS_STORAGE_DIR="./.local-storage/documents"

# Rate limiting.
ACRE_RATE_LIMIT_BACKEND="memory"
ACRE_RATE_LIMIT_FAIL_MODE="open"
ACRE_TRUSTED_PROXY_TIER="none"
# ACRE_RATE_LIMIT_REDIS_URL="redis://localhost:6379/0"
# ACRE_UPSTASH_REDIS_REST_URL="https://example.upstash.io"
# ACRE_UPSTASH_REDIS_REST_TOKEN="replace-with-upstash-rest-token"

# Observability.
ACRE_METRICS_TOKEN=""
PRISMA_SLOW_QUERY_MS="500"
PRISMA_VERY_SLOW_QUERY_MS="2000"
SENTRY_DSN=""
SENTRY_TRACES_SAMPLE_RATE="0.1"
SENTRY_AUTH_TOKEN=""

# Email and signatures. Leave blank unless testing email flows locally.
ACRE_RESEND_API_KEY=""
ACRE_SMTP_HOST="smtp.example.com"
ACRE_SMTP_PORT="587"
ACRE_SMTP_SECURE="false"
ACRE_SMTP_USER="smtp-user"
ACRE_SMTP_PASSWORD="replace-with-smtp-password"
ACRE_SIGNATURE_FROM_EMAIL="signatures@example.com"
ACRE_SIGNATURE_FROM_NAME="Acre Signatures"
ACRE_SIGNATURE_REPLY_TO="agent@example.com"

# Google OAuth integrations. Optional for local development.
ACRE_GOOGLE_OAUTH_CLIENT_ID=""
ACRE_GOOGLE_OAUTH_CLIENT_SECRET=""
ACRE_GOOGLE_OAUTH_REDIRECT_URL="http://localhost:3105/api/office/settings/google/callback"

# QuickBooks OAuth integrations. Optional for local development.
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_REDIRECT_URI="http://localhost:3105/api/office/settings/quickbooks/callback"
QUICKBOOKS_ENVIRONMENT="sandbox"
ACRE_QUICKBOOKS_CLIENT_ID=""
ACRE_QUICKBOOKS_CLIENT_SECRET=""
ACRE_QUICKBOOKS_REDIRECT_URI="http://localhost:3105/api/office/settings/quickbooks/callback"
ACRE_QUICKBOOKS_OFFICE_CONNECTIONS_JSON=""
ACRE_QUICKBOOKS_API_BASE_URL="https://quickbooks.api.intuit.com"
ACRE_QUICKBOOKS_MINOR_VERSION="75"

# Optional public browser configuration.
NEXT_PUBLIC_LISTING_STUDIO_EXTENSION_STORE_URL=""
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Optional Admin Assistant Codex CLI settings for local experiments.
ACRE_ADMIN_CODEX_BIN="codex"
ACRE_ADMIN_CODEX_MODEL="gpt-5.5"
ACRE_ADMIN_CODEX_WORKDIR="."
ACRE_ADMIN_CODEX_TIMEOUT_SECONDS="90"
ACRE_ADMIN_CODEX_MAX_IMAGES="3"
ACRE_ADMIN_CODEX_MAX_IMAGE_BYTES="1048576"
ACRE_ADMIN_CODEX_MAX_TOTAL_IMAGE_BYTES="2097152"
ACRE_ADMIN_CODEX_MAX_EXEC_OUTPUT_BYTES="524288"

# Optional Admin GPT action/OAuth settings. Leave blank unless developing this integration.
ACRE_ADMIN_GPT_URL=""
ACRE_ADMIN_GPT_OAUTH_CLIENT_ID=""
ACRE_ADMIN_GPT_OAUTH_CLIENT_SECRET=""
ACRE_ADMIN_GPT_OAUTH_SIGNING_SECRET=""
ACRE_ADMIN_GPT_ALLOWED_REDIRECT_HOSTS="localhost,127.0.0.1"

# Optional remote document sync configuration. Use safe local placeholders only.
ACRE_REMOTE_DOCUMENTS_SSH_TARGET=""
ACRE_REMOTE_DOCUMENTS_STORAGE_ROOT=""
ACRE_REMOTE_DOCUMENTS_SSH_KEY=""
ACRE_REMOTE_DOCUMENTS_SSH_KNOWN_HOSTS=""
